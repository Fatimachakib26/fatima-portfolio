# ------------------------------------------------------------------
# CRÉDIT HORIZON RISK INTELLIGENCE – variables d'environnement
# Ne jamais committer de vraies valeurs. Toutes les clés restent côté serveur.
# ------------------------------------------------------------------

# Base de données PostgreSQL / Supabase (chaîne de connexion "Transaction pooler" de Supabase)
# Si absent : base PostgreSQL embarquée (PGlite) dans ./.data – idéal pour la démo locale.
DATABASE_URL=

# Secret de signature des sessions (JWT). Générer : openssl rand -base64 32
AUTH_SECRET=

# Intelligence artificielle – Vercel AI Gateway (recommandé)
AI_GATEWAY_API_KEY=
# Modèle utilisé via la passerelle (format fournisseur/modèle)
AI_MODEL=anthropic/claude-sonnet-4.5

# Alternative : clé Anthropic directe (utilisée si AI_GATEWAY_API_KEY est absente)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
